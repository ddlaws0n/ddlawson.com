---
import Beliefs from "@/components/Beliefs.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero.astro";
import Nav from "@/components/Nav.astro";
import Projects from "@/components/Projects.astro";
import RecentWriting from "@/components/RecentWriting.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  meta={{
    title: "David D Lawson — Customer success, security, and side projects",
    description:
      "I lead a technical account management team at Wiz. I write about customer success and security, and build small tools outside work.",
  }}
>
  <div
    class="font-body bg-background text-text relative min-h-screen overflow-x-clip"
  >
    <div class="m-noise"></div>
    <Nav />
    <main id="main-content" class="max-w-content mx-auto px-(--m-gutter)">
      <Hero />
      <div class="m-divider"></div>
      <Beliefs />
      <RecentWriting />
      <Projects />
    </main>
    <Footer />
  </div>
</BaseLayout>
