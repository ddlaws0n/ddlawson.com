{
	"name": "ddlawson.com",
	"description": "Personal portfolio site built with Astro and Tailwind CSS.",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"fix:unsafe": "biome check --write .",
		"format": "biome format --write .",
		"types": "astro sync && tsc --noEmit",
		"generate:og": "bun scripts/generate-og-images.ts"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.3",
		"@iconify-json/tabler": "^1.2.33",
		"astro": "^6.4.6",
		"astro-favicons": "^3.1.6",
		"astro-icon": "^1.1.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/compiler-rs": "^0.2.2",
		"@astrojs/markdown-remark": "^7.2.0",
		"@biomejs/biome": "2.5.0",
		"@cloudflare/workers-types": "^4.20260615.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.1",
		"lefthook": "^2.1.9",
		"playwright": "^1.60.0",
		"sharp": "^0.35.1",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"vite": "^7.3.2",
		"wrangler": "4.100.0"
	},
	"packageManager": "pnpm@11.6.0"
}
